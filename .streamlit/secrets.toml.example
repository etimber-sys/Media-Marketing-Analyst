# Copy this to .streamlit/secrets.toml for local use,
# or add these values in the Streamlit Community Cloud dashboard under "Secrets".
# Never commit secrets.toml to git.

[snowflake]
account   = "your-snowflake-account"
user      = "your-username"
password  = "your-password"
database  = "STREAMING_ANALYTICS"
warehouse = "COMPUTE_WH"
role      = "SYSADMIN"
